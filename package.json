{
  "name": "n8n-nodes-calendar-gate",
  "version": "0.1.3",
  "description": "n8n community node to gate or stop workflow execution based on calendar rules, public holidays, days of the week, and date/time ranges.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "calendar",
    "holiday",
    "schedule",
    "gate"
  ],
  "license": "MIT",
  "author": {
    "name": "huyphan",
    "email": "huyplb@live.com"
  },
  "homepage": "https://github.com/tedious-code/n8n-nodes-calendar-gate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tedious-code/n8n-nodes-calendar-gate.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && cp nodes/CalendarGate/*.svg dist/nodes/CalendarGate/",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "dist/nodes/CalendarGate/CalendarGate.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "n8n-workflow": "^1.0.0",
    "typescript": "^5.6.0"
  }
}
